<%- include('../partials/header') %>

<section class="page-shell">
  <header class="page-header">
    <div class="page-title-group">
      <h1>Ventas</h1>
      <p>Listado básico de ventas registradas en el sistema.</p>
    </div>
    <div class="page-actions">
      <a class="button" href="/ventas/nueva"><span class="button-icon">＋</span><span>Nueva venta</span></a>
    </div>
  </header>

  <section class="page-body">
    <% if (message) { %>
      <section class="status ok">
        <strong>Listo:</strong>
        <span><%= message %></span>
      </section>
    <% } %>

    <section class="card">
      <div class="panel-header">
        <div>
          <h3>Ventas registradas</h3>
          <p>Historial de operaciones comerciales con acceso directo al detalle.</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>No. venta</th>
              <th>Cliente</th>
              <th>Vendedor</th>
              <th>Descuento</th>
              <th>Total</th>
              <th>Fecha</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (sales.length === 0) { %>
              <tr>
                <td colspan="7">Todavía no hay ventas registradas.</td>
              </tr>
            <% } %>
            <% sales.forEach(sale => { %>
              <tr>
                <td><%= sale.sale_number %></td>
                <td><%= sale.customer_name || 'Consumidor final' %></td>
                <td><%= sale.seller_name %></td>
                <td>Q <%= Number(sale.discount).toFixed(2) %></td>
                <td>Q <%= Number(sale.total).toFixed(2) %></td>
                <td><%= new Date(sale.created_at).toLocaleString('es-GT') %></td>
                <td><a class="button button-ghost button-sm" href="/ventas/<%= sale.id %>"><span class="button-icon">🧾</span><span>Ver detalle</span></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h3>Qué estás aprendiendo acá</h3>
      <ul class="info-list">
        <li>La venta ya no es solo lectura: afecta inventario y finanzas.</li>
        <li>En una operación de negocio real, varias tablas cambian dentro de una misma transacción.</li>
        <li>Eso evita inconsistencias como descontar stock sin registrar la venta.</li>
      </ul>
    </section>
  </section>
</section>

<%- include('../partials/footer') %>
