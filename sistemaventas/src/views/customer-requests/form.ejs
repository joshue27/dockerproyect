<%- include('../partials/header') %>

<section class="page-shell">
  <header class="page-header">
    <div class="page-title-group">
      <h1>Nueva solicitud</h1>
      <p>Registro básico de pedidos especiales, consultas y reclamos de clientes.</p>
    </div>
  </header>

  <section class="page-body">
    <% if (errors.length > 0) { %>
      <section class="status warn">
        <strong>Corregí estos puntos:</strong>
        <ul class="info-list">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="card">
      <form class="form" method="POST" action="/solicitudes">
        <div class="form-grid">
          <label>
            Nombre del cliente
            <input type="text" name="customerName" value="<%= request.customerName %>" required>
          </label>

          <label>
            Teléfono
            <input type="text" name="contactPhone" value="<%= request.contactPhone %>">
          </label>

          <label>
            Tipo de solicitud
            <select name="requestTypeId" required>
              <option value="">Seleccioná una opción</option>
              <% requestTypes.forEach(type => { %>
                <option value="<%= type.id %>" <%= String(type.id) === String(request.requestTypeId) ? 'selected' : '' %>><%= type.name %></option>
              <% }) %>
            </select>
          </label>

          <label class="full-width">
            Descripción
            <textarea name="description" rows="5" required><%= request.description %></textarea>
          </label>
        </div>

        <div class="form-actions">
          <a class="button button-secondary button-sm" href="/solicitudes"><span class="button-icon">←</span><span>Cancelar</span></a>
          <button class="button button-sm" type="submit"><span class="button-icon">✔</span><span>Registrar solicitud</span></button>
        </div>
      </form>
    </section>
  </section>
</section>

<%- include('../partials/footer') %>
