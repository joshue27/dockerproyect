<%- include('../partials/header') %>

<section class="page-shell">
  <header class="page-header">
    <div class="page-title-group">
      <h1><%= request.customer_name %></h1>
      <p>Detalle completo de la solicitud registrada y seguimiento de su estado.</p>
    </div>
  </header>

  <section class="page-body">
    <section class="card detail-grid">
      <div>
        <strong>Tipo</strong>
        <p><%= request.request_type %></p>
      </div>
      <div>
        <strong>Estado actual</strong>
        <p><span class="badge"><%= request.status_name %></span></p>
      </div>
      <div>
        <strong>Teléfono</strong>
        <p><%= request.contact_phone || 'Sin teléfono' %></p>
      </div>
      <div>
        <strong>Registrado por</strong>
        <p><%= request.created_by_name %></p>
      </div>
      <div class="full-width">
        <strong>Descripción</strong>
        <p><%= request.description %></p>
      </div>
    </section>

    <section class="card">
      <div class="panel-header">
        <div>
          <h3>Actualizar estado</h3>
          <p>Mantené el seguimiento operativo de esta solicitud.</p>
        </div>
      </div>
      <form class="form-inline" method="POST" action="/solicitudes/<%= request.id %>/estado">
        <label>
          Nuevo estado
          <select name="statusId">
            <% statuses.forEach(status => { %>
              <option value="<%= status.id %>" <%= status.id === request.status_id ? 'selected' : '' %>><%= status.name %></option>
            <% }) %>
          </select>
        </label>
        <button class="button button-sm" type="submit"><span class="button-icon">✔</span><span>Actualizar</span></button>
      </form>
    </section>
  </section>
</section>

<%- include('../partials/footer') %>
