<%- include('../partials/header') %>

<section class="page-shell">
  <header class="page-header">
    <div class="page-title-group">
      <h1><%= formTitle %></h1>
      <p><%= helpText %></p>
    </div>
  </header>

  <section class="page-body">
    <% if (errors.length > 0) { %>
      <section class="status warn">
        <strong>Corregí estos puntos:</strong>
        <ul class="info-list">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="card">
      <form class="form" method="POST" action="<%= formAction %>">
        <div class="form-grid">
          <label>
            Usuario
            <input type="text" name="username" value="<%= user.username %>" required>
          </label>

          <label>
            Nombre completo
            <input type="text" name="fullName" value="<%= user.fullName %>" required>
          </label>

          <label>
            Correo electrónico
            <input type="email" name="email" value="<%= user.email %>">
          </label>

          <label>
            Rol
            <select name="roleId" required>
              <option value="">Seleccioná un rol</option>
              <% roles.forEach(role => { %>
                <option value="<%= role.id %>" <%= String(role.id) === String(user.roleId) ? 'selected' : '' %>><%= role.name %></option>
              <% }) %>
            </select>
          </label>

          <label class="full-width">
            Contraseña <%= isEdit ? '(dejala vacía si no querés cambiarla)' : '' %>
            <input type="password" name="password" value="">
          </label>

          <label class="checkbox-field">
            <input type="checkbox" name="isActive" <%= user.isActive ? 'checked' : '' %>>
            Usuario activo
          </label>
        </div>

        <div class="form-actions">
          <a class="button button-secondary button-sm" href="/usuarios"><span class="button-icon">←</span><span>Cancelar</span></a>
          <button class="button button-sm" type="submit"><span class="button-icon">✔</span><span><%= submitLabel %></span></button>
        </div>
      </form>
    </section>

    <section class="card">
      <h3>Buenas prácticas que estás aplicando</h3>
      <ul class="info-list">
        <li>La administración de usuarios está separada de la autenticación.</li>
        <li>Solo un administrador puede operar este módulo.</li>
        <li>La baja es lógica mediante estado activo/inactivo.</li>
        <li>La contraseña puede mantenerse intacta en edición si no se informa una nueva.</li>
      </ul>
    </section>
  </section>
</section>

<%- include('../partials/footer') %>
