<%- include('../partials/header') %>

<section class="page-shell">
  <header class="page-header">
    <div class="page-title-group">
      <h1>Productos</h1>
      <p>Listado mínimo para validar el módulo de inventario.</p>
    </div>
    <div class="page-actions">
      <a class="button" href="/productos/nuevo"><span class="button-icon">＋</span><span>Nuevo producto</span></a>
    </div>
  </header>

  <section class="page-body">
    <% if (message) { %>
      <section class="status ok">
        <strong>Listo:</strong>
        <span><%= message %></span>
      </section>
    <% } %>

    <section class="card toolbar">
      <div class="filter-group">
        <span>Filtro actual:</span>
        <a class="<%= filter === 'all' ? 'filter-link active-filter' : 'filter-link' %>" href="/productos">Todos</a>
        <a class="<%= filter === 'low-stock' ? 'filter-link active-filter' : 'filter-link' %>" href="/productos?filter=low-stock">Stock bajo</a>
      </div>
    </section>

    <section class="card">
      <div class="panel-header">
        <div>
          <h3>Inventario</h3>
          <p>Catálogo visible, filtrable y con acciones operativas rápidas.</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>SKU</th>
              <th>Nombre</th>
              <th>Precio</th>
              <th>Stock</th>
              <th>Stock mínimo</th>
              <th>Activo</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (products.length === 0) { %>
              <tr>
                <td colspan="7">No hay productos para mostrar con el filtro actual.</td>
              </tr>
            <% } %>
            <% products.forEach(product => { %>
              <tr>
                <td><%= product.sku %></td>
                <td><%= product.name %></td>
                <td>Q <%= Number(product.price).toFixed(2) %></td>
                <td class="<%= product.stock <= product.min_stock ? 'text-danger' : '' %>"><%= product.stock %></td>
                <td><%= product.min_stock %></td>
                <td><%= product.active ? 'Sí' : 'No' %></td>
                <td class="actions-cell">
                  <a class="button button-ghost button-sm" href="/productos/<%= product.id %>"><span class="button-icon">👁</span><span>Ver</span></a>
                  <a class="button button-secondary button-sm" href="/productos/<%= product.id %>/editar"><span class="button-icon">✎</span><span>Editar</span></a>
                  <form method="POST" action="/productos/<%= product.id %>/toggle-active" class="inline-form">
                    <button type="submit" class="button <%= product.active ? 'button-soft' : 'button-secondary' %> button-sm">
                      <span class="button-icon"><%= product.active ? '⏸' : '▶' %></span>
                      <span><%= product.active ? 'Desactivar' : 'Activar' %></span>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</section>

<%- include('../partials/footer') %>
